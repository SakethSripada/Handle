{
  "name": "handle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "tsx --env-file=.env src/server.ts",
    "build": "tsc --noEmit && vite build",
    "check": "npm run format:check && npm run lint && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check:intake": "tsx --env-file=.env scripts/check-intake.ts",
    "check:outcomes": "tsx --env-file=.env scripts/check-outcomes.ts",
    "setup:voice": "tsx --env-file=.env scripts/setup-voice.ts",
    "doctor": "tsx --env-file=.env scripts/doctor.ts",
    "format": "eslint . --fix && stylelint \"web/**/*.css\" --fix && prettier --write .",
    "format:check": "prettier --check .",
    "setup:phone": "tsx --env-file=.env scripts/setup-phone.ts",
    "lint": "eslint . && stylelint \"web/**/*.css\"",
    "setup:photon": "tsx --env-file=.env scripts/setup-photon-voice.ts",
    "state:generate": "node scripts/generate-state.mjs",
    "state:migrate": "tsx --env-file=.env scripts/migrate-state.ts",
    "check:state": "tsx --env-file=.env scripts/check-state.ts",
    "check:voice": "tsx --env-file=.env scripts/check-voice.ts"
  },
  "dependencies": {
    "@elevenlabs/client": "^1.26.0",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.51.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "spacetimedb": "2.10.2",
    "spectrum-ts": "^12.10.1",
    "twilio": "^6.1.2",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "prettier": "^3.9.9",
    "stylelint": "^17.16.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.2"
  }
}
